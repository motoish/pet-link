{
  "name": "pet-link",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "bun run build && wrangler deploy",
    "test": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run test -- --run && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "husky": "^9.1.7",
    "oxfmt": "0.61.0",
    "oxlint": "^1.76.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  },
  "packageManager": "bun@1.3.14"
}
